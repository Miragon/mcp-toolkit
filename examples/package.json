{
  "name": "@miragon/mcp-toolkit-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone playground for the MCP toolkit. Not published — consumed locally via pnpm workspace.",
  "scripts": {
    "dev:articles-upstream": "tsx --env-file-if-exists=.env articles-upstream/server.ts",
    "dev:customers-upstream": "pnpm run build:customer-widget && tsx --env-file-if-exists=.env customers-upstream/server.ts",
    "dev:host": "tsx --env-file-if-exists=.env host/index.ts",
    "build:bundle": "vite build --config app-bundle/vite.config.ts",
    "build:customer-widget": "vite build --config customers-upstream/widget/vite.config.ts",
    "generate": "pnpm --filter articles-example run generate",
    "generate:check": "pnpm --filter articles-example run generate:check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@miragon/mcp-toolkit-proxy-contract": "workspace:*",
    "@miragon/mcp-toolkit-tool-codegen": "workspace:*",
    "@miragon/mcp-toolkit-ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "mcp-use": "1.23.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "yaml": "2.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "tailwindcss": "4.2.2",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vite-plugin-singlefile": "2.3.2"
  }
}
