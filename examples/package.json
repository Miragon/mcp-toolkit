{
  "name": "@miragon/mcp-toolkit-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone playground for the MCP toolkit. Not published — consumed locally via pnpm workspace.",
  "scripts": {
    "dev:articles-upstream": "tsx --env-file-if-exists=.env articles-upstream/server.ts",
    "dev:customers-upstream": "pnpm run build:customer-widget && tsx --env-file-if-exists=.env customers-upstream/server.ts",
    "dev:host": "tsx --env-file-if-exists=.env host/index.ts",
    "_wait:upstreams": "wait-on -t 30000 tcp:4000 tcp:4001",
    "_dev:host-gated": "pnpm run _wait:upstreams && pnpm run dev:host",
    "dev:all": "concurrently -n articles,customers,host -c green,magenta,cyan --kill-others-on-fail \"pnpm run dev:articles-upstream\" \"tsx --env-file-if-exists=.env customers-upstream/server.ts\" \"pnpm run _dev:host-gated\"",
    "build:bundle": "vite build --config app-bundle/vite.config.ts",
    "build:customer-widget": "vite build --config customers-upstream/widget/vite.config.ts",
    "build:all": "pnpm run build:bundle && pnpm run build:customer-widget",
    "start": "pnpm run build:all && pnpm run dev:all",
    "generate": "pnpm --filter articles-example run generate",
    "generate:check": "pnpm --filter articles-example run generate:check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@miragon/mcp-toolkit-proxy-contract": "workspace:*",
    "@miragon/mcp-toolkit-tool-codegen": "workspace:*",
    "@miragon/mcp-toolkit-ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "mcp-use": "1.30.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.7",
    "wait-on": "9.0.10"
  }
}
