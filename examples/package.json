{
  "name": "@miragon/mcp-toolkit-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone playground for the MCP toolkit. Not published — consumed locally via pnpm workspace.",
  "scripts": {
    "dev:upstream": "tsx upstream-mock/server.ts",
    "dev:host": "tsx host/index.ts",
    "generate": "pnpm --filter items-ui-example run generate",
    "generate:check": "pnpm --filter items-ui-example run generate:check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@miragon/mcp-toolkit-proxy-contract": "workspace:*",
    "@miragon/mcp-toolkit-tool-codegen": "workspace:*",
    "@miragon/mcp-toolkit-ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "mcp-use": "1.23.1",
    "react": "19.2.5",
    "yaml": "2.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  }
}
