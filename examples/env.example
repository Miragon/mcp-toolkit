# Example host configuration. Copy to `.env`, then `pnpm dev:all`
# (or `pnpm start`, which builds the bundles first).
#
# The host (`pnpm dev:host`) serves FOUR modules at once, covering every kind:
#   articles    UI-only — federates articles-upstream's tools (proxy + codegen)
#   customers   fully upstream-hosted — step + widget discovered via manifest
#   tasks       self-owned — registers its own tools + widget (no upstream)
#   orders      self-owned — eager dashboard + a two-step pipeline (no upstream)
#
# `tasks` and `orders` are local plugins compiled into the host: they need no
# upstream server and no env — they run automatically. Only `articles` and
# `customers` are external upstreams, so only they appear below and in MCP_PROXIES.
#
# The two standalone UI demos need NO env and no server:
#   pnpm dev:widget-playground   isolated widget development (fixture data)
#   pnpm dev:host-portability    one widget under mcp-use / ChatGPT / standalone

# --- Host server (pnpm dev:host) ---
PORT=3010
MCP_URL=http://localhost:3010

# --- articles upstream (pnpm dev:articles-upstream) ---
# UPSTREAM_ARTICLES_URL types the codegen'd tool calls for the host-bundled UI.
UPSTREAM_ARTICLES_PORT=4000
UPSTREAM_ARTICLES_URL=http://localhost:4000/mcp

# --- customers upstream (pnpm dev:customers-upstream) ---
UPSTREAM_CUSTOMERS_PORT=4001

# --- Proxy config consumed by the host ---
#   articles    routes to articles-upstream; host ships the widget code; codegen
#               types the tool calls (host-bundled UI path).
#   customers   routes to customers-upstream; the upstream ships BOTH the
#               declarative step AND the widget bundle (fully remote module path —
#               exercises read-widget-bundle end-to-end).
# `upstreamModules: true` opts a proxy into the host's module discovery (calls
# `get-module-manifest` at boot and registers the returned declarative
# steps/widgets as a synthetic AppPlugin). articles-upstream has no manifest, so
# it stays off.
MCP_PROXIES=[{"name":"articles","label":"Articles","upstreamUrl":"http://localhost:4000/mcp","auth":{"mode":"none"}},{"name":"customers","label":"Customers","upstreamUrl":"http://localhost:4001/mcp","auth":{"mode":"none"},"upstreamModules":true}]
