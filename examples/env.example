# Host-side examples server. Copy to `.env` and adjust as needed.
PORT=3010
MCP_URL=http://localhost:3010

# Upstream mock (used as the "external MCP" proxied through the host)
UPSTREAM_MOCK_PORT=4000
UPSTREAM_MOCK_URL=http://localhost:4000/mcp

# Proxy config consumed by the host. `items` routes calls to the upstream-mock.
# `upstreamModules: true` opts the proxy into the host's module discovery path
# (calls `get-module-manifest` at boot and registers the returned declarative
# steps/widgets as a synthetic AppPlugin).
MCP_PROXIES=[{"name":"items","label":"Items Mock","upstreamUrl":"http://localhost:4000/mcp","auth":{"mode":"none"},"upstreamModules":true}]

# Optional: restrict to a subset of modules
# MCP_ACTIVE_MODULES=hello,items
