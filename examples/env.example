# Host-side examples server. Copy to `.env` and adjust as needed.
PORT=3010
MCP_URL=http://localhost:3010

# Articles upstream — host-bundled UI path (plain external MCP, no manifest).
UPSTREAM_ARTICLES_PORT=4000
UPSTREAM_ARTICLES_URL=http://localhost:4000/mcp

# Customers upstream — ships its own declarative step *and* a remote widget bundle.
UPSTREAM_CUSTOMERS_PORT=4001
UPSTREAM_CUSTOMERS_URL=http://localhost:4001/mcp

# Proxy config consumed by the host.
#   articles    routes to articles-upstream; host ships the widget code;
#               codegen types the tool calls (host-bundled UI path).
#   customers   routes to customers-upstream; the upstream ships both
#               the declarative step AND the widget bundle (fully remote
#               module path — exercises read-widget-bundle end-to-end).
# `upstreamModules: true` opts a proxy into the host's module discovery
# (calls `get-module-manifest` at boot and registers the returned declarative
# steps/widgets as a synthetic AppPlugin). Articles-upstream has no manifest,
# so it stays off.
MCP_PROXIES=[{"name":"articles","label":"Articles","upstreamUrl":"http://localhost:4000/mcp","auth":{"mode":"none"}},{"name":"customers","label":"Customers","upstreamUrl":"http://localhost:4001/mcp","auth":{"mode":"none"},"upstreamModules":true}]

# Optional: restrict to a subset of modules
# MCP_ACTIVE_MODULES=articles,customers
