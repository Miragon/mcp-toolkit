      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Mark a task as done by its id. Idempotent: completing an already-done task is a no-op. Returns the updated task.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "taskId": {
          "description": "Id of the task to complete (as returned by list_tasks).",
          "type": "string"
        }
      },
      "required": ["taskId"],
      "type": "object"
    },
    "name": "complete_task",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "completedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO-8601 completion timestamp, or null while the task is open."
        },
        "createdAt": {
          "description": "ISO-8601 creation timestamp.",
          "type": "string"
        },
        "id": {
          "description": "Stable task id.",
          "type": "string"
        },
        "priority": {
          "description": "Relative urgency of the task.",
          "enum": ["low", "medium", "high"],
          "type": "string"
        },
        "status": {
          "description": "Lifecycle state: 'todo' (open), 'doing' (in progress), or 'done' (completed).",
          "enum": ["todo", "doing", "done"],
          "type": "string"
        },
        "title": {
          "description": "Human-readable task title.",
          "type": "string"
        }
      },
      "required": ["id", "title", "status", "priority", "createdAt", "completedAt"],
      "type": "object"
    }
  },
