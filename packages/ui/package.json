{
  "name": "@miragon/mcp-toolkit-ui",
  "version": "0.1.0",
  "description": "React UI for MCP servers: shadcn primitives, composite components, TanStack Query hooks, and the MCP App shell (McpAppView + WidgetRenderer).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./globals.css": "./src/globals.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "peerDependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "mcp-use": "1.23.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.2"
  },
  "dependencies": {
    "@base-ui/react": "1.4.0",
    "@fontsource-variable/geist": "5.2.8",
    "@tanstack/react-query": "5.99.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "radix-ui": "1.4.3",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "mcp-use": "1.23.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  }
}
