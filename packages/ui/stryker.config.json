{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/lib/parse-tool-result.ts",
    "src/lib/tone-utils.ts",
    "src/lib/typography.ts",
    "src/lib/utils.ts",
    "src/theme/create-theme.ts",
    "src/theme/fonts.ts",
    "src/theme/host-fonts.ts",
    "src/theme/cd-tokens.ts",
    "src/app/builder/builder-model.ts",
    "src/app/builder/builder-reducer.ts",
    "src/app/view-lifecycle.ts",
    "src/lib/toast-model.ts",
    "src/lib/focus-return.ts",
    "src/locale/toolkit-messages.ts"
  ],
  "incremental": false,
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 85
  },
  "reporters": ["progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "plugins": ["@stryker-mutator/vitest-runner"]
}
