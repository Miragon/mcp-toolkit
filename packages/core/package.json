{
  "name": "@miragon/mcp-toolkit-core",
  "version": "0.1.0",
  "description": "Framework runtime for MCP servers: plugin contract, step/widget registries, pipeline executor, render-view helpers.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "import": "./dist/rest/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "tsc"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "mcp-use": "1.23.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "25.6.0",
    "mcp-use": "1.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "zod": "4.3.6"
  }
}
