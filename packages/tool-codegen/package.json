{
  "name": "@miragon/mcp-toolkit-tool-codegen",
  "version": "2.2.0",
  "description": "Build-time codegen + runtime glue for type-safe MCP tool calls: TypedCallTool helper and a CLI that generates TypeScript types + React Query hooks from an MCP server's tools/list.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/mcp-toolkit.git",
    "directory": "packages/tool-codegen"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-tool-codegen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "handlebars": "4.7.9",
    "json-schema-to-typescript": "15.0.4"
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "mcp-use": "2.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
