{
  "name": "@miragon/mcp-toolkit-tool-codegen",
  "version": "3.0.0",
  "description": "Build-time codegen for typed MCP tool calls: a CLI that turns an MCP server's tools/list into TypeScript types, a typed client and (opt-in) React hooks.",
  "license": "MIT",
  "homepage": "https://miragon.github.io/mcp-toolkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/mcp-toolkit.git",
    "directory": "packages/tool-codegen"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-tool-codegen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "handlebars": "4.7.10",
    "json-schema-to-typescript": "16.0.0"
  },
  "peerDependencies": {
    "@miragon/mcp-toolkit-tool-codegen-core": "workspace:~",
    "@miragon/mcp-toolkit-tool-codegen-react": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@miragon/mcp-toolkit-tool-codegen-core": {
      "optional": true
    },
    "@miragon/mcp-toolkit-tool-codegen-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-tool-codegen-core": "workspace:*",
    "@miragon/mcp-toolkit-tool-codegen-react": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "4.10.2",
    "mcp-use": "2.9.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
