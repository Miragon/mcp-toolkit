{
  "name": "@miragon/mcp-toolkit-tool-codegen",
  "version": "0.8.0",
  "description": "Build-time codegen + runtime glue for type-safe MCP tool calls: TypedCallTool helper and a CLI that generates TypeScript types + React Query hooks from an upstream MCP's tools/list. (buildProxyAppConfigs lives in @miragon/mcp-toolkit-core.)",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-tool-codegen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "dependencies": {
    "handlebars": "4.7.9",
    "json-schema-to-typescript": "15.0.4"
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
