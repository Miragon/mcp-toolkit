{
  "name": "@miragon/mcp-toolkit-tool-codegen-core",
  "version": "3.0.0",
  "description": "Framework-free runtime for typed MCP tool calls: the ToolCaller contract, the typed call and client the codegen emits, and tool-result parsing. No React, no Node APIs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/mcp-toolkit.git",
    "directory": "packages/tool-codegen-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
