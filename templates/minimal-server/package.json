{
  "name": "my-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.32.1",
  "description": "Minimal MCP server built on @miragon/mcp-toolkit: a plain mcp-use project with the toolkit installed on top — one module with its own tools, one widget, views served by the mcp-use CLI.",
  "scripts": {
    "dev": "mcp-use dev --no-open",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@miragon/mcp-toolkit-core": "2.2.0",
    "@miragon/mcp-toolkit-ui": "2.2.0",
    "lucide-react": "0.562.0",
    "mcp-use": "2.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
