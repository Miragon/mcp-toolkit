{
  "name": "mcp-toolkit",
  "version": "1.1.0",
  "private": true,
  "description": "Shared framework runtime and UI primitives for mcp-use based MCP servers",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "clean": "pnpm -r exec rm -rf dist",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "lint:templates": "eslint templates --max-warnings 0",
    "fitness:tighten": "node scripts/tighten-ratchets.mjs",
    "dump:tools": "pnpm --filter @miragon/mcp-toolkit-examples exec tsx dump-tools-list.ts",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages examples",
    "depcruise:dist": "depcruise --config .dependency-cruiser.dist.cjs packages/core/dist/index.js packages/ui/dist/index.js",
    "depcruise:report": "depcruise --config .dependency-cruiser.cjs packages examples --output-type json --output-to reports/depcruise.json",
    "knip:gate": "knip --include files,dependencies,unlisted",
    "knip:report": "knip --no-exit-code --reporter json",
    "mutation:diff": "node scripts/mutation-diff.mjs",
    "fitness": "node scripts/fitness-report.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm depcruise && pnpm depcruise:dist && node scripts/check-ratchets.mjs && pnpm knip:gate && pnpm test:coverage && pnpm --filter @miragon/mcp-toolkit-examples run generate:check:ci && pnpm lint && pnpm lint:templates && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --filter @miragon/mcp-toolkit-docs run dev",
    "docs:build": "pnpm --filter @miragon/mcp-toolkit-docs run build",
    "docs:preview": "pnpm --filter @miragon/mcp-toolkit-docs run preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "knip": "6.32.1",
    "lint-staged": "17.2.0",
    "picomatch": "4.0.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{mjs,cjs,js,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
