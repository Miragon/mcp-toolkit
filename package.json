{
  "name": "mcp-toolkit",
  "version": "0.8.0",
  "private": true,
  "description": "Shared framework runtime and UI primitives for mcp-use based MCP servers",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r exec rm -rf dist",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --filter @miragon/mcp-toolkit-docs run dev",
    "docs:build": "pnpm --filter @miragon/mcp-toolkit-docs run build",
    "docs:preview": "pnpm --filter @miragon/mcp-toolkit-docs run preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{mjs,cjs,js,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
