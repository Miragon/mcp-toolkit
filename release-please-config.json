{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "mcp-toolkit",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "packages/core/src/module-loader/discover.ts" },
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/proxy-contract/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/tool-codegen/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/ui/package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "templates/minimal-server/package.json",
          "jsonpath": "$.dependencies['@miragon/mcp-toolkit-core']"
        },
        {
          "type": "json",
          "path": "templates/minimal-server/package.json",
          "jsonpath": "$.dependencies['@miragon/mcp-toolkit-proxy-contract']"
        },
        {
          "type": "json",
          "path": "templates/minimal-server/package.json",
          "jsonpath": "$.dependencies['@miragon/mcp-toolkit-ui']"
        }
      ]
    }
  }
}
