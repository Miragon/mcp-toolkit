{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "mcp-toolkit",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/tool-codegen/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/tool-codegen-core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/tool-codegen-react/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
