{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "mcp-toolkit",
      "release-as": "1.0.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/tool-codegen/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "templates/minimal-server/package.json",
          "jsonpath": "$.dependencies['@miragon/mcp-toolkit-core']"
        },
        {
          "type": "json",
          "path": "templates/minimal-server/package.json",
          "jsonpath": "$.dependencies['@miragon/mcp-toolkit-ui']"
        }
      ]
    }
  }
}
